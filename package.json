{
  "name": "mtg-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A Claude Code agent that answers Magic: The Gathering rules questions from the Comprehensive Rules, with a zero-dependency Bun build that chunks the rules and a skill to update them.",
  "scripts": {
    "build": "bun run scripts/build-rules.ts",
    "fetch": "bun run scripts/fetch-rules.ts",
    "update": "bun run scripts/fetch-rules.ts && bun run scripts/build-rules.ts",
    "card": "bun run scripts/card.ts",
    "edhrec": "bun run scripts/edhrec.ts",
    "search": "bun run scripts/card.ts search",
    "cards:refresh": "bun run scripts/card.ts refresh",
    "set-scan": "bun run scripts/set-scan.ts",
    "carddata": "bun run scripts/carddata.ts",
    "deckcheck": "bun run scripts/deckcheck.ts",
    "test": "bun test test/",
    "deck:pdf": "bun run scripts/deck-pdf.ts",
    "deck:proposal": "bun run scripts/deck-proposal.ts",
    "deck:moxfield": "bun run scripts/deck-moxfield.ts",
    "deck:migrate": "bun run scripts/deck-migrate.ts",
    "deck": "bun run scripts/deck.ts",
    "deck:show": "bun run scripts/deck.ts show",
    "deck:edit": "bun run scripts/deck.ts edit",
    "deck:meta": "bun run scripts/deck.ts meta",
    "lookup": "bun run scripts/ledger.ts lookup",
    "ledger:index": "bun run scripts/ledger.ts index"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
