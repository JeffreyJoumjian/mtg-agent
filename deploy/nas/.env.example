# Copy to .env in the UGOS project folder and fill in. .env stays on the NAS, never in git.

TZ=Europe/Bucharest

# The NAS user that owns the share, the same values the other projects use, so files the
# containers write stay editable over SMB.
PUID=1000
PGID=100

# The Workbench's port on the NAS, and the proxy name(s) Vite accepts, comma-separated.
WORKBENCH_PORT=3200
WORKBENCH_ALLOWED_HOSTS=mtg.home.example.com

# A fine-grained GitHub token with Contents read and write on the mtg-agent-data repo only.
GITHUB_TOKEN=

# The nightly edhplay-data push runs once a day after this hour (24-hour clock, TZ above).
SYNC_HOUR=4
