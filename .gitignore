# macOS
.DS_Store

# Editor cruft
*.swp
*~
.idea/
.vscode/

# Logs
*.log

# Bun (no deps, but just in case)
node_modules/
bun.lockb

# Ephemeral, rebuildable Scryfall card cache (see decks/README.md). Anchored to the repo root —
# an unanchored `data/` also swallowed source dirs like apps/…/src/lib/data/.
/data/

# Playwright MCP scratch output
.playwright-mcp/

# Raw deck-editor exports dropped at the repo root while researching. The ones worth keeping
# get cleaned up into decks/<slug>/samples/ — see decks/README.md.
/moxfield-*.json

# Generated proposal-artifact payload. The hand-written half lives in
# decks/<slug>/research/proposal.json and IS tracked; everything under artifact/ except the page
# itself is rebuilt by `bun run deck:proposal <slug>` (see deck-brain §3.1).
decks/*/artifact*/img/
decks/*/artifact*/proposal.json

# EDHPlay Lens game records (see scripts/lib/edhplay-store.ts). Other players' usernames and chat
# live here and this repo is public, so it never gets committed. It is NOT a rebuildable cache:
# EDHPlay's free tier only keeps the last 5 matches. Back it up somewhere private.
/edhplay-data/

# The EDHPlay Lens extension build output (`bun run lens:build`).
apps/edhplay-lens/dist/
