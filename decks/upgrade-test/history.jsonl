{"id":"muh5hoxx-3iv79r","at":"2026-09-25T16:03:48.741Z","listId":"main","label":"Wave 3 — converters and a one-sided wipe","author":"user","rationale":"Blasphemous Edict costs {B} with 13+ creatures on the battlefield (all players count, locked on cast), you choose your own thirteen, and your death payoffs trigger 13 times looking back in time — a sweeper and a converter in one card. Yawgmoth is the outlet that PAYS: a card per sacrifice plus removal, and not a Game Changer. Champion of Lambholt makes the alpha strike connect. Awaken the Woods is a mass land drop, a mass token event and permanent ramp at once. Known cost: removal drops 6 -> 5.","entries":[{"op":"add","name":"Blasphemous Edict","section":"Board Wipes","replaces":"Toxic Deluge"},{"op":"add","name":"Yawgmoth, Thran Physician","section":"Sacrifice Outlets","replaces":"Sakura-Tribe Elder"},{"op":"add","name":"Champion of Lambholt","section":"Token Engines","replaces":"Abrupt Decay"},{"op":"add","name":"Awaken the Woods","section":"Ramp & Mana","replaces":"Cultivate"},{"op":"remove","name":"Toxic Deluge"},{"op":"remove","name":"Sakura-Tribe Elder"},{"op":"remove","name":"Abrupt Decay"},{"op":"remove","name":"Cultivate"}],"snapshot":"versions/2026-09-25-1603-main-wave-3-converters-and-a-one-sided-wipe.json","before":{"size":{"total":100,"target":100,"lands":36,"nonland":64,"commanders":1},"curve":{"avgMv":2.94,"avgMvNonZero":2.94,"histogram":[{"mv":"0","creature":0,"noncreature":0},{"mv":"1","creature":4,"noncreature":4},{"mv":"2","creature":6,"noncreature":11},{"mv":"3","creature":12,"noncreature":11},{"mv":"4","creature":7,"noncreature":2},{"mv":"5","creature":2,"noncreature":2},{"mv":"6","creature":1,"noncreature":0},{"mv":"7+","creature":2,"noncreature":0}]},"types":{"creature":34,"instant":9,"sorcery":4,"artifact":8,"enchantment":10,"planeswalker":0,"battle":0,"land":36},"color":{"identity":["B","G"],"pips":{"W":0,"U":0,"B":30,"R":0,"G":49},"sources":{"W":10,"U":10,"B":31,"R":10,"G":30}},"roles":{"sec