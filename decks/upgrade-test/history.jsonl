{"id":"muh5hccj-a8d92j","at":"2026-09-25T16:03:32.419Z","listId":"main","label":"Wave 1 — a win that isn't the combo","author":"user","rationale":"Craterhoof converts a wide board without the sac loop; Concordant Crossroads is the haste it needs (Craterhoof grants trample, not haste); Ancient Greenwarden doubles every landfall trigger as separate events so Chatterfang applies twice; Mycoloth trades 2 bodies/turn for 16; Circle of Dreams Druid is the mana for the top end. Out: the per-upkeep drip (From Beyond, Tendershoot Dryad, Bitterblossom), the third lifegain converter (Marauding Blight-Priest) and Blade of the Bloodchief.","entries":[{"op":"add","name":"Craterhoof Behemoth","section":"Finishers & Equipment","replaces":"From Beyond"},{"op":"add","name":"Concordant Crossroads","section":"Ramp & Mana","replaces":"Tendershoot Dryad"},{"op":"add","name":"Ancient Greenwarden","section":"Ramp & Mana","replaces":"Bitterblossom"},{"op":"add","name":"Mycoloth","section":"Token Engines","replaces":"Marauding Blight-Priest"},{"op":"add","name":"Circle of Dreams Druid","section":"Ramp & Mana","replaces":"Blade of the Bloodchief"},{"op":"remove","name":"From Beyond"},{"op":"remove","name":"Tendershoot Dryad"},{"op":"remove","name":"Bitterblossom"},{"op":"remove","name":"Marauding Blight-Priest"},{"op":"remove","name":"Blade of the Bloodchief"}],"snapshot":"versions/2026-09-25-1603-main-wave-1-a-win-that-isn-t-the-combo.json","before":{"size":{"total":100,"target":100,"lands":36,"nonland":64,"commanders":1},"curve":{"avgMv":2.73,"avgMvNonZero":2.73,"histogram":[{"mv":"0","creature":0,"noncreature":0},{"mv":"1","creature":5,"noncreature":4},{"mv":"2","creature":7,"noncreature":14},{"mv":"3","creature":11,"noncreature":8},{"mv":"4","creature":7,"noncreature":3},{"mv":"5","creature":2,"noncreature":2},{"mv":"6","creature":0,"noncreature":0},{"mv":"7+","creature":1,"noncreature":0}]},"types":{"creature":33,"instant":10,"sorcery":4,"artifact":8,"enchantment":10,"planeswalker":0,"ba