{"id":"muh5hiy4-7o2yzu","at":"2026-09-25T16:03:40.972Z","listId":"main","label":"Wave 2 — Food and Treasure multiplication","author":"user","rationale":"Orcrist on forestwalking Chatterfang is the largest token event available (15 Squirrels = 15 Treasures, x3 through Academy Manufactor, then Chatterfang last = 90+ tokens). Bilbo is the splitter that doubles what Manufactor triples. Ninja Pizza turns every Food into mana and adds a free token event each turn. Cauldron of Essence is Bastion of Remembrance on an artifact, so wipes miss it. Ordering law: Peregrin -> Tippy-Toe -> Bilbo -> Manufactor -> Chatterfang last.","entries":[{"op":"add","name":"Orcrist, Goblin-cleaver","section":"Finishers & Equipment","replaces":"Verdant Command"},{"op":"add","name":"Bilbo, Fellow Conspirator","section":"Token Engines","replaces":"Nested Shambler"},{"op":"add","name":"Ninja Pizza","section":"Ramp & Mana","replaces":"Idol of Oblivion"},{"op":"add","name":"Cauldron of Essence","section":"Drain Payoffs","replaces":"Dina, Soul Steeper"},{"op":"remove","name":"Verdant Command"},{"op":"remove","name":"Nested Shambler"},{"op":"remove","name":"Idol of Oblivion"},{"op":"remove","name":"Dina, Soul Steeper"}],"snapshot":"versions/2026-09-25-1603-main-wave-2-food-and-treasure-multiplication.json","before":{"size":{"total":100,"target":100,"lands":36,"nonland":64,"commanders":1},"curve":{"avgMv":2.86,"avgMvNonZero":2.86,"histogram":[{"mv":"0","creature":0,"noncreature":0},{"mv":"1","creature":5,"noncreature":4},{"mv":"2","creature":7,"noncreature":13},{"mv":"3","creature":11,"noncreature":8},{"mv":"4","creature":7,"noncreature":2},{"mv":"5","creature":2,"noncreature":2},{"mv":"6","creature":1,"noncreature":0},{"mv":"7+","creature":2,"noncreature":0}]},"types":{"creature":35,"instant":10,"sorcery":4,"artifact":7,"enchantment":9,"planeswalker":0,"battle":0,"land":36},"color":{"identity":["B","G"],"pips":{"W":0,"U":0,"B":31,"R":0,"G":48},"sources":{"W":9,"U":9,"B":30,"R":9,"G":29}},"roles":{"sec